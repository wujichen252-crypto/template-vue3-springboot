# ==========================================
# GitHub Actions CI/CD 配置模板
# 将以下变量配置到 GitHub Settings -> Secrets and variables -> Actions
# ==========================================

# ==========================================
# Secrets (加密存储，仅管理员可见)
# ==========================================
# SSH_PRIVATE_KEY=服务器SSH私钥，用于CI连接服务器
# 获取方式：服务器执行 cat ~/.ssh/id_rsa

# ==========================================
# Variables (明文存储)
# ==========================================

# 服务器配置
DEPLOY_SERVER_HOST=123.456.78.90
DEPLOY_SERVER_USER=root
DEPLOY_SERVER_PORT=22

# 部署路径
DEPLOY_FRONTEND_PATH=/www/wwwroot/template-vue3
DEPLOY_BACKEND_PATH=/www/template-api

# JAR和服务配置
DEPLOY_JAR_NAME=template-api.jar
DEPLOY_SERVICE_NAME=template-api
DEPLOY_RESTART_COMMAND=sudo systemctl restart template-api

# 项目目录配置
PROJECT_FRONTEND_DIR=./frontend
PROJECT_BACKEND_DIR=./backend

# 构建工具配置
BUILD_TOOL=maven
JAVA_VERSION=17
NODE_VERSION=20

# 应用配置
APP_PORT=8080
SPRING_PROFILE=prod
JAVA_OPTS=-Xms256m -Xmx512m
ENABLE_FLYWAY=true

# 可选：部署通知Webhook
# DEPLOY_NOTIFY_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
